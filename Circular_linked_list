#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next;
} *head = NULL;

int count()
{
    struct node *temp;
    int i = 0;
    if (head == NULL) {
        return 0;
    }
    temp = head;
    do {
        temp = temp->next;
        i++;
    } while (temp != head);
    return i;
}

struct node *create(int value)
{
    struct node *temp;
    temp = (struct node *)malloc(sizeof(struct node));
    temp->data = value;
    temp->next = NULL;
    return temp;
}

void insert_pos(int value, int pos)
{
    struct node *newnode, *temp;
    int c = 1;
    int size = count();
    if (pos < 1 || pos > size + 1)
    {
        printf("Insertion is not possible at this position.\n");
        return;
    }

    newnode = create(value);
    
    if (head == NULL)
    {
        head = newnode;
        newnode->next = head;
    }
    else if (pos == 1)
    {
        temp = head;
        while (temp->next != head)
        {
            temp = temp->next;
        }
        newnode->next = head;
        temp->next = newnode;
        head = newnode;
    }
    else
    {
        temp = head;
        while (c < pos - 1)
        {
            temp = temp->next;
            c++;
        }
        newnode->next = temp->next;
        temp->next = newnode;
    }
    printf("\nInserted Element at position %d\n", pos);
}

void delete_pos(int pos)
{
    struct node *temp1, *temp2;
    int c = 1;
    int size = count();
    if (head == NULL)
    {
        printf("Deletion is not possible. List is empty.\n");
        return;
    }
    if (pos < 1 || pos > size)
    {
        printf("Deletion is not possible at this position.\n");
        return;
    }
    
    if (head->next == head && pos == 1)
    {
        free(head);
        head = NULL;
    }
    else if (pos == 1)
    {
        temp1 = head;
        temp2 = head;
        while (temp2->next != head)
        {
            temp2 = temp2->next;
        }
        head = head->next;
        temp2->next = head;
        free(temp1);
    }
    else
    {
        temp1 = head;
        while (c < pos - 1)
        {
            temp1 = temp1->next;
            c++;
        }
        temp2 = temp1->next;
        temp1->next = temp2->next;
        free(temp2);
    }
    printf("\nDeleted Element at position %d\n", pos);
}

void display()
{
    struct node *temp;
    if (head == NULL)
    {
        printf("List is empty.\n");
        return;
    }
    temp = head;
    printf("List: ");
    do
    {
        printf("%d -> ", temp->data);
        temp = temp->next;
    } while (temp != head);
    printf(" (Head)\n");
}

void main()
{
    int ch, pos, value;
    printf("=============================================================\n                   Circular Single Linked List Programming       \n=============================================================\n");
    do
    {
        printf("\n*\n1. Insert at Position\n2. Delete at Position\n3. Display\n4. Count\n5. Exit\n*\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);
        switch (ch)
        {
        case 1:
            printf("Enter value: ");
            scanf("%d", &value);
            printf("Enter position: ");
            scanf("%d", &pos);
            insert_pos(value, pos);
            break;
        case 2:
            printf("Enter position: ");
            scanf("%d", &pos);
            delete_pos(pos);
            break;
        case 3:
            display();
            break;
        case 4:
            printf("The number of elements in the list are %d\n", count());
            break;
        case 5:
            break;
        default:
            printf("Incorrect choice!\n");
        }
    } while (ch != 5);
}
